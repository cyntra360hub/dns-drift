# Copy to .env for local runs. Never commit the real .env (it's gitignored).

# Optional: comma-separated domain list. Defaults to
# aiopsenabler.com, cyntra360hub.com
DNS_DRIFT_DOMAINS=

# Optional: where to persist the last-seen DNS snapshot per domain.
DNS_DRIFT_STATE_FILE=.state/dns_drift_state.json

# Optional: AiOps Enabler reporting. Leave both blank to run fully offline
# with no phone-home. Set both to enable signed task-event reporting.
DNS_DRIFT_AGENT_KEY_ID=
DNS_DRIFT_AGENT_SECRET=
DNS_DRIFT_BASE_URL=https://api.aiopsenabler.com
